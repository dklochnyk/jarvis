# Put the key for the AI you chose in config.yaml (provider:)
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=your-key-here
# only needed if tts.provider is elevenlabs
ELEVENLABS_API_KEY=
# Spotify Premium: Client ID of your app from developer.spotify.com/dashboard (see README)
SPOTIFY_CLIENT_ID=your-spotify-client-id
